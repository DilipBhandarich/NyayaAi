# ============================================
# NyayaAI Environment Configuration (MERN Stack)
# ============================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nyaya_ai
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/nyaya_ai

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# OpenAI
# Provide your OpenAI API key for AI-powered analysis
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
